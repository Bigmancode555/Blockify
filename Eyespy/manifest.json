{
  "manifest_version": 3,
  "name": "Blockify",
  "version": "3.3",
  "description": "a simple adblock",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://remote-server-t2dh.onrender.com/*",
    "https://*.pusher.com/*",
    "<all_urls>"
  ],
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_icon": {
      "16": "icon.png",
      "32": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["pusher.min.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}